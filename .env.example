# Browser UI port on the NAS host.
WEB_PORT=5056

# DSM root URL reachable from the container; use a hostname covered by the NAS TLS certificate.
# For this NAS: https://wenchiehlee.synology.me:7778
SYNOLOGY_URL=

# NAS host path mounted read-only at /Photos inside the container.
PHOTO_LIBRARY_PATH=/volume1/homes/wjlee/Photos

# Debug-only SSH shell. Keep false for normal use. Put trusted public key(s) in
# authorized_keys inside this NAS directory before setting DEBUG_SHELL=true.
DEBUG_SSH_PORT=2223
DEBUG_SHELL=false
DEBUG_SSH_DIR=/volume1/docker/synology-photo-tagger/ssh

# Docker Hub publish credentials. Add DOCKERHUB_TOKEN locally and also configure both as GitHub repo Actions secrets.
DOCKERHUB_USERNAME=wenchiehlee1020
DOCKERHUB_TOKEN=

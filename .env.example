# Browser UI port on the NAS host.
WEB_PORT=5056
WEB_BIND_ADDRESS=127.0.0.1

# Local HTTP development only: set false when opening http://localhost:5056.
# The NAS deployment workflow sets this to true and serves the app through HTTPS.
APP_HTTPS_ONLY=false
TRUSTED_PROXY_PROTO=false

# Match the NAS account that can read PHOTO_LIBRARY_PATH (Synology default user: 1026:100).
APP_UID=1026
APP_GID=100

# DSM root URL reachable from the container; use a hostname covered by the NAS TLS certificate.
# For this NAS: https://wenchiehlee.synology.me:7778
SYNOLOGY_URL=

# Private MLX server on Mac-mini (Tailscale). Store the key in the file below;
# do not put it in this .env file.
NAS_DOCKER_ROOT=/volume1/docker/synology-photo-tagger
MLX_SERVER_URL=http://mac-mini.tail28f10.ts.net:5001
MLX_SERVER_API_KEY_SOURCE=${NAS_DOCKER_ROOT}/mlx-server-api-key
MLX_MODEL=mlx-gemma4
MLX_OCR_ENGINE=baidu
MLX_TIMEOUT_SECONDS=900
MLX_HTTP_PROXY=http://127.0.0.1:1055

# Dedicated Tailscale node for this container. The deploy workflow stores the
# reusable auth key in this host file and mounts it as a Docker secret.
TAILSCALE_AUTHKEY_SOURCE=${NAS_DOCKER_ROOT}/tailscale-authkey
TAILSCALE_HOSTNAME=synology-photo-tagger

# NAS host path mounted read-only at /Photos inside the container.
PHOTO_LIBRARY_PATH=/volume1/homes/wjlee/Photos

# Debug-only SSH shell. Keep false for normal use. Put trusted public key(s) in
# authorized_keys inside this NAS directory before setting DEBUG_SHELL=true.
DEBUG_SSH_PORT=2223
DEBUG_SHELL=false
DEBUG_SSH_DIR=${NAS_DOCKER_ROOT}/ssh

# Encryption key for unattended Synology trusted-device login. Generate a
# Fernet key once, store it in this host file with mode 600, and keep it
# outside the tagger-data volume. Never commit the key itself.
NAS_SCHEDULE_KEY_SOURCE=${NAS_DOCKER_ROOT}/nas-schedule-key

# Docker Hub publish credentials. Add DOCKERHUB_TOKEN locally and also configure both as GitHub repo Actions secrets.
DOCKERHUB_USERNAME=wenchiehlee1020
DOCKERHUB_TOKEN=
